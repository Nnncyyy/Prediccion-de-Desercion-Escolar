# RNF_01 / RNF_03 · Plantilla de backend/.env. Genera los secretos con backend/scripts/generar_env.py.
DATABASE_URL=sqlite:///./sipde.db
# Usa false en PostgreSQL y aplica primero las migraciones de Alembic.
AUTO_CREATE_TABLES=true
JWT_SECRET=CAMBIAR_JWT_SECRET
ADMIN_EMAIL=admin@sipde.local
ADMIN_PASSWORD=CAMBIAR_ADMIN_PASSWORD
CORS_ORIGINS=http://localhost:5173
MODEL_PATH=ml/artifacts/dropout_model.joblib
# Opcional. Si está vacía, se genera una clave para las nuevas cuentas de demostración.
SEED_PASSWORD=
# Para Docker Compose o la configuración de PostgreSQL.
POSTGRES_PASSWORD=CAMBIAR_POSTGRES_PASSWORD
